.dev-app {
    color: #d8d8d8;
    background-color: #0e0f0f;
    border-color: transparent;
    decorator: image("assets/mods_nordic_bg.png" fill);
}

.dev-sidebar {
    width: 468px;
    height: 1076px;
    padding: 0;
    background-color: rgba(11, 12, 12, 205);
    border-right-color: transparent;
}

.dev-sidebar .brand {
    width: 468px;
    height: 118px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: 0;
    padding: 0;
}

.dev-sidebar .brand-copy {
    width: 468px;
    margin-left: 0;
}

.dev-sidebar .brand-name {
    position: relative;
    top: 59px;
    width: 468px;
    display: flex;
    justify-content: center;
    color: #999b9b;
    font-size: 32px;
    letter-spacing: 1px;
    text-align: center;
}

.dev-sidebar .brand-name span {
    display: block;
}

.dev-sidebar-copy {
    position: relative;
    top: 32px;
    width: 468px;
    margin: 8px 0 0;
    color: #a7a9a9;
    font-size: 34px;
    line-height: 1.08;
    text-align: center;
}

.dev-sidebar-line {
    width: 468px;
    display: flex;
    justify-content: center;
    text-align: center;
}

.dev-sidebar-line span {
    display: block;
}

.dev-nav {
    position: relative;
    top: 72px;
    left: 44px;
    width: 404px;
    margin-left: 0;
}

.dev-sidebar .nav-item {
    width: 404px;
    height: 104px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
    padding: 0 20px;
    color: #b7b8b8;
    font-size: 38px;
    line-height: 1.1;
    text-align: center;
    background-color: rgba(23, 24, 24, 190);
    border: 1px #505252;
    border-radius: 3px;
}

.dev-sidebar .nav-item span {
    display: block;
}

.dev-sidebar .nav-item:hover {
    color: #eeeeee;
    background-color: rgba(42, 43, 43, 220);
    border-color: #747676;
}

.dev-sidebar .nav-item.active {
    color: #f0f0f0;
    background-color: rgba(55, 56, 56, 230);
    border-color: #8b8d8d;
}

.dev-sidebar .sidebar-status {
    left: 32px;
    right: 32px;
    bottom: 42px;
    padding: 18px 8px 0;
    color: #a7a9a9;
    font-size: 30px;
    text-align: center;
    border-top: 0px transparent;
}

.developer-status-line,
.dev-sidebar .version {
    width: 404px;
    display: flex;
    justify-content: center;
    text-align: center;
}

.developer-status-line span,
.dev-sidebar .version span {
    display: block;
}

.dev-sidebar .version {
    margin: 8px 0 0;
    color: #7f8181;
    font-size: 26px;
}

.dev-shell {
    position: relative;
    width: 1448px;
    height: 1076px;
    background-color: rgba(12, 13, 13, 118);
}

.dev-header {
    width: 1448px;
    height: 145px;
    padding: 0 72px 0 96px;
    background-color: rgba(17, 18, 18, 105);
    border-bottom-color: transparent;
}

.dev-header .breadcrumb {
    position: relative;
    top: 28px;
    color: #eeeeee;
    font-size: 72px;
    line-height: 1.0;
}

.dev-header .breadcrumb span {
    display: block;
}

.dev-header .close-button {
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    color: #dedede;
    font-size: 40px;
    line-height: 1.0;
    text-align: center;
    border-color: #565858;
}

.dev-header .close-button span {
    display: block;
}

.dev-main {
    width: 1448px;
    height: 781px;
    padding: 32px 42px 24px 96px;
    overflow-y: hidden;
    background-color: rgba(10, 11, 11, 96);
}

.dev-page {
    width: 1310px;
}

.dev-app.calibration-mode {
    background-color: transparent;
    decorator: none;
}

.dev-app.calibration-mode .dev-shell,
.dev-app.calibration-mode .dev-main {
    background-color: transparent;
}

.dev-app.calibration-mode .dev-sidebar {
    background-color: transparent;
    border-right-color: transparent;
}

.dev-app.calibration-mode .brand,
.dev-app.calibration-mode .sidebar-status,
.dev-app.calibration-mode .dev-footer {
    display: none;
}

.dev-app.calibration-mode .dev-nav,
.dev-app.calibration-mode .dev-header .close-button {
    position: relative;
    z-index: 4;
}

.calibration-page {
    position: relative;
    width: 1310px;
    height: 725px;
}

.calibration-toolbar {
    position: absolute;
    z-index: 6;
    top: 0;
    left: 0;
    width: 1310px;
    padding: 16px 20px;
    background-color: rgba(13, 15, 16, 242);
    border: 1px #696d6e;
    border-radius: 4px;
}

.calibration-title {
    color: #eeeeee;
    font-size: 34px;
    letter-spacing: 1px;
}

.calibration-instructions {
    margin-top: 5px;
    color: #b9bcbd;
    font-size: 26px;
}

.calibration-cities {
    position: relative;
    z-index: 7;
    display: flex;
    margin-top: 12px;
}

.calibration-city {
    width: 240px;
    height: 76px;
    margin-right: 12px;
    padding: 7px 10px;
    color: #d0d2d2;
    font-size: 27px;
    line-height: 1.0;
    background-color: rgba(35, 38, 39, 235);
    border: 1px #626667;
    border-radius: 3px;
}

.calibration-city span {
    display: block;
}

.calibration-city.active {
    color: #ffffff;
    background-color: rgba(66, 78, 82, 245);
    border-color: #c2c9cb;
}

.calibration-status {
    margin-top: 6px;
    color: #9fa5a6;
    font-size: 19px;
}

.calibration-summary {
    margin-top: 10px;
    color: #d2d5d5;
    font-size: 24px;
}

.calibration-summary-row {
    display: flex;
    align-items: center;
}

.calibration-summary-row .calibration-summary {
    width: 1000px;
}

.calibration-reset {
    position: relative;
    z-index: 8;
    width: 245px;
    height: 48px;
    margin-top: 8px;
    color: #dddddd;
    font-size: 22px;
    background-color: rgba(58, 36, 36, 235);
    border: 1px #876262;
    border-radius: 3px;
}

.calibration-map-frame {
    width: 690px;
    height: 478px;
    margin: 14px auto 0 auto;
    overflow: hidden;
    background-color: #101414;
    border: 1px #747b7d;
    border-radius: 4px;
}

.calibration-map-image {
    width: 690px;
    height: 478px;
}

.calibration-surface {
    display: none;
    position: absolute;
    z-index: 2;
    top: 942px;
    left: 720px;
    width: 480px;
    height: 90px;
    padding: 0;
    color: #ffffff;
    font-size: 28px;
    text-align: center;
    background-color: rgba(42, 77, 67, 245);
    border: 2px #a7c7bc;
    border-radius: 4px;
}

.dev-app.calibration-mode .calibration-surface {
    display: block;
}

.calibration-surface:hover {
    color: #ffffff;
    background-color: rgba(55, 105, 89, 255);
    border-color: #ffffff;
}

.command-workspace {
    width: 1310px;
    height: 725px;
    display: flex;
}

.command-list-panel {
    width: 410px;
    height: 725px;
    padding: 22px;
    background-color: rgba(24, 25, 25, 225);
    border: 1px #555757;
    border-radius: 3px;
}

.command-list {
    width: 364px;
    height: 638px;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
}

.command-item {
    display: block;
    width: 364px;
    min-height: 74px;
    margin-bottom: 8px;
    padding: 12px 16px;
    color: #b7b8b8;
    font-size: 36px;
    line-height: 1.12;
    text-align: left;
    border: 1px transparent;
    border-radius: 3px;
}

.command-item:hover {
    color: #eeeeee;
    background-color: rgba(43, 44, 44, 238);
    border-color: #686a6a;
}

.command-item.active {
    color: #f1f1f1;
    background-color: rgba(58, 59, 59, 238);
    border-color: #8b8d8d;
}

.command-details {
    position: relative;
    width: 880px;
    height: 725px;
    margin-left: 20px;
    padding: 24px 28px;
    background-color: rgba(20, 21, 21, 225);
    border: 1px #555757;
    border-radius: 3px;
}

.subheading {
    width: 100%;
    display: flex;
    padding-bottom: 11px;
    margin-bottom: 18px;
    color: #9b9d9d;
    font-size: 28px;
    line-height: 1.15;
    letter-spacing: 3px;
    border-bottom: 1px #505252;
}

.subheading span {
    display: block;
}

.command-title {
    display: block;
    color: #eeeeee;
    font-size: 52px;
    line-height: 1.08;
}

.command-description {
    display: block;
    min-height: 116px;
    margin-top: 14px;
    color: #b9baba;
    font-size: 34px;
    line-height: 1.18;
}

.console-label {
    display: flex;
    margin-top: 14px;
    color: #9b9d9d;
    font-size: 27px;
    letter-spacing: 2px;
}

.console-label span {
    display: block;
}

.console-input {
    display: block;
    min-height: 72px;
    margin-top: 8px;
    padding: 14px 18px;
    color: #e0e0e0;
    font-size: 36px;
    line-height: 1.15;
    background-color: rgba(12, 13, 13, 235);
    border: 1px #555757;
    border-radius: 3px;
}

.warning {
    display: none;
    margin-top: 12px;
    padding: 10px 15px;
    color: #d0d0d0;
    font-size: 28px;
    line-height: 1.15;
    background-color: rgba(45, 28, 28, 225);
    border-left: 4px #8f3434;
}

.command-actions {
    position: absolute;
    right: 28px;
    bottom: 24px;
    display: flex;
}

.add-command-button,
.execute-button {
    width: 290px;
    height: 68px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff0f0;
    font-size: 34px;
    line-height: 1.1;
    text-align: center;
    background-color: #2c0d12;
    border: 1px #452027;
    border-radius: 5px;
}

.add-command-button {
    margin-right: 18px;
    color: #e7e7e7;
    background-color: #3d3f3f;
    border-color: #6c6f6f;
}

.add-command-button span,
.execute-button span {
    display: block;
}

.add-command-button:hover {
    color: #ffffff;
    background-color: #525454;
    border-color: #8b8e8e;
}

.execute-button:hover {
    color: #ffffff;
    background-color: #3b1218;
    border-color: #5d343c;
}

.execute-button:disabled {
    opacity: 0.4;
}

.empty-state {
    display: block;
    padding: 22px 12px;
    color: #929494;
    font-size: 34px;
    text-align: center;
}

.info-grid {
    width: 1310px;
    display: flex;
}

.info-card {
    width: 645px;
    height: 310px;
    min-height: 310px;
    margin-right: 20px;
    padding: 18px 22px;
    background-color: rgba(24, 25, 25, 225);
    border: 1px #555757;
    border-radius: 3px;
}

.performance-card,
.runtime-card {
    height: 725px;
    min-height: 725px;
}

.performance-card .subheading,
.runtime-card .subheading {
    margin-bottom: 18px;
    padding-bottom: 12px;
    font-size: 34px;
}

.performance-card .info-row,
.runtime-card .info-row {
    padding: 7px 9px;
}

.runtime-card .info-row {
    min-height: 70px;
    font-size: 36px;
}

.performance-card .info-row {
    min-height: 52px;
    font-size: 31px;
}

.performance-card .timing-row {
    min-height: 58px;
    font-size: 29px;
}

.performance-card .primary-timing-row {
    color: #ffffff;
    border-bottom-color: #777a7a;
}

.timing-header {
    width: 100%;
    min-height: 46px;
    display: flex;
    justify-content: space-between;
    padding: 5px 9px;
    color: #8f9191;
    font-size: 25px;
    letter-spacing: 1px;
}

.location-subheading {
    margin-top: 24px;
}

.last-info-card {
    margin-right: 0;
}

.location-card {
    display: block;
    width: 1310px;
    height: 397px;
    min-height: 397px;
    margin: 18px 0 0;
    padding: 18px 22px;
}

.info-row {
    width: 100%;
    min-height: 53px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 4px 8px;
    color: #b8b9b9;
    font-size: 30px;
    line-height: 1.12;
    border-bottom: 1px #484a4a;
}

.info-value {
    color: #eeeeee;
    text-align: right;
}

.info-note {
    display: block;
    margin-top: 10px;
    color: #8f9191;
    font-size: 29px;
    line-height: 1.15;
}

.dev-footer {
    width: 1448px;
    height: 150px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 150px 0 96px;
    background-color: rgba(15, 16, 16, 105);
    border-top: 0px transparent;
}

.dev-footer-hints {
    position: relative;
    top: -26px;
    display: flex;
    align-items: center;
    color: #b8baba;
    font-size: 34px;
    line-height: 1.1;
}

.dev-footer-hints span {
    display: block;
}

.dev-hint-divider {
    width: 1px;
    height: 30px;
    margin: 0 28px;
    background-color: #656766;
}

/* Nordic panel standard shared with Inventory, Magic and Mods. */
.dev-app {
    background-color: #070808;
    decorator: image("assets/mods_nordic_bg.png" fill);
}

.dev-sidebar,
.dev-shell,
.dev-header,
.dev-main,
.dev-footer {
    background-color: transparent;
}

.dev-sidebar .brand-name {
    color: #d6d7d7;
    font-size: 48px;
}

.dev-nav {
    top: 72px;
}

.dev-sidebar .nav-item {
    position: relative;
    overflow: hidden;
    color: #d9dada;
    font-size: 42px;
    background-color: transparent;
    border: 0px transparent;
}

.dev-sidebar .nav-item:hover,
.dev-sidebar .nav-item.active {
    color: #ffffff;
    background-color: transparent;
    border-color: transparent;
}

.fade-layer {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 104px;
    display: block;
    pointer-events: none;
    decorator: horizontal-gradient(rgba(0, 0, 0, 112) rgba(0, 0, 0, 16));
}

.dev-sidebar .nav-item:hover .fade-layer,
.dev-sidebar .nav-item.active .fade-layer {
    decorator: horizontal-gradient(rgba(44, 13, 18, 210) rgba(44, 13, 18, 25));
}

.dev-sidebar .nav-item span {
    position: relative;
    z-index: 2;
}

.dev-header {
    border-bottom: 1px rgba(120, 122, 122, 90);
}

.dev-header .breadcrumb {
    color: #eeeeee;
    font-size: 64px;
}

.dev-header .close-button {
    display: none;
}

.command-list-panel,
.command-details,
.info-card {
    background-color: transparent;
    border: 1px rgba(100, 102, 102, 120);
}

.command-item {
    position: relative;
    overflow: hidden;
    min-height: 92px;
    color: #d3d4d4;
    font-size: 40px;
    background-color: transparent;
    border: 0px transparent;
}

.command-item:hover {
    background-color: rgba(39, 39, 39, 118);
    border-color: transparent;
}

.command-item.active {
    background-color: transparent;
    border-color: transparent;
}

.command-item .fade-layer,
.journal-quest-button .fade-layer {
    height: 100px;
}

.command-item:hover .fade-layer,
.command-item.active .fade-layer,
.journal-quest-button:hover .fade-layer,
.journal-quest-button.active .fade-layer {
    decorator: horizontal-gradient(rgba(44, 13, 18, 210) rgba(44, 13, 18, 25));
}

.fade-label,
.journal-quest-marker,
.journal-quest-title {
    position: relative;
    z-index: 2;
}

.add-command-button,
.execute-button,
.calibration-reset {
    color: #e5dcde;
    background-color: #2c0d12;
    border-color: #452027;
}

.add-command-button:hover,
.execute-button:hover,
.calibration-reset:hover {
    color: #fff1f2;
    background-color: #3b1218;
    border-color: #5d343c;
}

.console-input,
.warning {
    background-color: rgba(0, 0, 0, 118);
}

.command-list scrollbarvertical,
.dev-main scrollbarvertical {
    width: 42px;
    background-color: transparent;
    border: 0px transparent;
}

.command-list scrollbarvertical sliderarrowdec,
.command-list scrollbarvertical sliderarrowinc,
.dev-main scrollbarvertical sliderarrowdec,
.dev-main scrollbarvertical sliderarrowinc {
    width: 0;
    height: 0;
}

.command-list scrollbarvertical slidertrack,
.dev-main scrollbarvertical slidertrack {
    width: 26px;
    margin-left: 8px;
    background-color: rgba(50, 54, 58, 82);
    border: 1px rgba(106, 112, 118, 72);
    border-radius: 6px;
}

.command-list scrollbarvertical sliderbar,
.dev-main scrollbarvertical sliderbar {
    width: 22px;
    min-height: 116px;
    margin-left: 10px;
    background-color: rgba(128, 142, 151, 138);
    border: 1px rgba(166, 178, 185, 118);
    border-radius: 5px;
}

/* Developer panel alignment corrections. */
.dev-sidebar .brand-name {
    position: absolute;
    z-index: 2;
    left: 108px;
    top: 72px;
    width: 340px;
    height: 62px;
    align-items: flex-end;
    justify-content: flex-start;
    color: #eeeeee;
    font-size: 48px;
    text-align: left;
}

.dev-app .dev-nav,
.dev-app.calibration-mode .dev-nav {
    position: absolute;
    top: 177px;
    left: -12px;
    width: 474px;
    margin: 0;
}

.dev-sidebar .nav-item {
    width: 474px;
    justify-content: flex-start;
    padding-left: 76px;
    text-align: left;
}

.dev-app.calibration-mode .brand {
    display: flex;
}

.dev-header {
    border-bottom: 0px transparent;
}

.command-list-panel {
    width: 541px;
}

.command-list {
    width: 495px;
}

.command-item {
    width: 477px;
    background-color: rgba(12, 13, 13, 217);
}

.command-list scrollbarvertical {
    position: relative;
    left: 28px;
}

.command-item:hover {
    background-color: rgba(35, 36, 36, 217);
}

.command-item.active {
    background-color: rgba(44, 13, 18, 217);
}

.command-item .fade-layer {
    display: none;
}

.command-item span {
    position: relative;
    z-index: 2;
    display: block;
}

.command-details {
    width: 820px;
}

.dev-main {
    padding-left: 25px;
}

.dev-page,
.command-workspace {
    width: 1381px;
}

/* Compact typography for longer Russian Developer labels. */
.lang-ru .dev-sidebar .brand-name {
    font-size: 40px;
}

.lang-ru .dev-sidebar .nav-item {
    font-size: 32px;
    line-height: 1.05;
}

.lang-ru .developer-status-line {
    font-size: 26px;
}

.lang-ru .subheading {
    font-size: 24px;
    letter-spacing: 2px;
}

.lang-ru .command-title {
    font-size: 46px;
}

.lang-ru .command-description {
    font-size: 31px;
}

.lang-ru .console-label {
    font-size: 24px;
    letter-spacing: 1px;
}

.lang-ru .warning {
    font-size: 24px;
}

.lang-ru .add-command-button,
.lang-ru .execute-button {
    font-size: 28px;
}

.lang-ru .performance-card .subheading,
.lang-ru .runtime-card .subheading {
    font-size: 28px;
}

.lang-ru .runtime-card .info-row {
    font-size: 30px;
}

.lang-ru .performance-card .info-row {
    font-size: 27px;
}

.lang-ru .performance-card .timing-row {
    font-size: 25px;
}

.lang-ru .timing-header {
    font-size: 22px;
    letter-spacing: 0px;
}

.lang-ru .info-note {
    font-size: 25px;
}

.lang-ru .dev-footer-hints {
    font-size: 27px;
}

.lang-ru .dev-hint-divider {
    margin: 0 20px;
}

.lang-ru .calibration-title {
    display: block;
    width: 100%;
    font-size: 29px;
}

.lang-ru .calibration-instructions {
    display: block;
    width: 100%;
    font-size: 23px;
}

.lang-ru .calibration-city {
    font-size: 24px;
}

.lang-ru .calibration-status {
    font-size: 17px;
}

.lang-ru .calibration-reset {
    font-size: 20px;
}

.lang-ru .calibration-surface {
    font-size: 24px;
}
