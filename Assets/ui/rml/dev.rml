<rml>
<head>
    <title>DragonBoard Developer</title>
    <link type="text/rcss" href="settings.rcss" />
    <link type="text/rcss" href="dev.rcss" />
</head>
<body>
    <div id="app" class="dev-app">
        <aside class="dev-sidebar">
            <div class="brand">
                <div class="brand-copy">
                    <div class="brand-name"><span>DragonBoard / Dev</span></div>
                </div>
            </div>

            <div class="dev-nav">
                <button id="dev-tab-commands" class="nav-item"><span>Console commands</span></button>
                <button id="dev-tab-info" class="nav-item"><span>Game information</span></button>
                <button id="dev-tab-calibration" class="nav-item"><span>Map calibration</span></button>
            </div>

            <div class="sidebar-status developer-status">
                <div class="developer-status-line"><span>Developer mode</span></div>
            </div>
        </aside>

        <div class="content-shell dev-shell">
            <header class="dev-header">
                <div class="breadcrumb"><span>Dev</span></div>
                <button id="dev-close" class="close-button"><span>X</span></button>
            </header>

            <main id="page-scroll" class="dev-main">
                <section id="dev-page-commands" class="page dev-page">
                    <div class="command-workspace">
                        <div class="command-list-panel">
                            <div class="subheading"><span>AVAILABLE COMMANDS</span></div>
                            <div id="dev-command-list" class="command-list"></div>
                        </div>

                        <div class="command-details">
                            <div class="subheading"><span>COMMAND DETAILS</span></div>
                            <div id="dev-command-title" class="command-title">No command selected</div>
                            <div id="dev-command-description" class="command-description"></div>
                            <div class="console-label"><span>CONSOLE INPUT</span></div>
                            <div id="dev-command-input" class="console-input"></div>
                            <div id="dev-command-warning" class="warning">
                                This command closes DragonBoard and runs after a safe delay.
                            </div>
                            <div class="command-actions">
                                <button id="dev-add-command" class="add-command-button"><span>Add command</span></button>
                                <button id="dev-execute" class="execute-button"><span>Execute command</span></button>
                            </div>
                        </div>
                    </div>
                </section>

                <section id="dev-page-info" class="page dev-page">
                    <div class="info-grid">
                        <div class="info-card">
                            <div class="subheading"><span>PERFORMANCE</span></div>
                            <div class="info-row"><span>FPS (Present)</span><span id="dev-fps" class="info-value">0.0</span></div>
                            <div class="info-row"><span>Frame time</span><span id="dev-frame-time" class="info-value">0.00 ms</span></div>
                            <div class="info-row"><span>Panel draw calls</span><span id="dev-draw-calls" class="info-value">0</span></div>
                            <div class="info-note">Panel-only count; this does not instrument every Skyrim draw call.</div>
                        </div>

                        <div class="info-card last-info-card">
                            <div class="subheading"><span>RUNTIME</span></div>
                            <div class="info-row"><span>Panel texture</span><span id="dev-texture-size" class="info-value">1920 x 1080</span></div>
                            <div class="info-row"><span>Panel renderer</span><span class="info-value">RmlUi 6.2</span></div>
                            <div class="info-row"><span>DragonBoardVR</span><span id="dev-version" class="info-value">-</span></div>
                            <div class="info-row"><span>D3D feature level</span><span id="dev-feature-level" class="info-value">-</span></div>
                        </div>
                    </div>

                    <div class="info-card location-card">
                        <div class="subheading"><span>PLAYER AND LOCATION</span></div>
                        <div class="info-row"><span>Player position</span><span id="dev-player-position" class="info-value">X 0.0   Y 0.0   Z 0.0</span></div>
                        <div class="info-row"><span>Cell</span><span id="dev-cell" class="info-value">&lt;none&gt;</span></div>
                        <div class="info-row"><span>Cell FormID</span><span id="dev-cell-form" class="info-value">00000000</span></div>
                        <div class="info-row"><span>Worldspace</span><span id="dev-worldspace" class="info-value">&lt;interior or none&gt;</span></div>
                        <div class="info-row"><span>Worldspace FormID</span><span id="dev-worldspace-form" class="info-value">--------</span></div>
                    </div>
                </section>

                <section id="dev-page-calibration" class="page dev-page calibration-page">
                    <div class="calibration-toolbar">
                        <div class="calibration-title">MAP MARKER CALIBRATION</div>
                        <div class="calibration-instructions">
                            Fast travel to a city, select its name, then press CAPTURE CURRENT SPAWN. The map landmark is fixed automatically.
                        </div>
                        <div class="calibration-cities">
                            <button id="dev-cal-city-0" class="calibration-city active"><span>Whiterun</span><span id="dev-cal-status-0" class="calibration-status">Not captured</span></button>
                            <button id="dev-cal-city-1" class="calibration-city"><span>Riften</span><span id="dev-cal-status-1" class="calibration-status">Not captured</span></button>
                            <button id="dev-cal-city-2" class="calibration-city"><span>Solitude</span><span id="dev-cal-status-2" class="calibration-status">Not captured</span></button>
                            <button id="dev-cal-city-3" class="calibration-city"><span>Falkreath</span><span id="dev-cal-status-3" class="calibration-status">Not captured</span></button>
                            <button id="dev-cal-city-4" class="calibration-city"><span>Windhelm</span><span id="dev-cal-status-4" class="calibration-status">Not captured</span></button>
                        </div>
                        <div class="calibration-summary-row">
                            <div id="dev-calibration-summary" class="calibration-summary">0/5 points captured</div>
                            <button id="dev-calibration-reset" class="calibration-reset"><span>Reset calibration</span></button>
                        </div>
                        <div class="calibration-map-frame">
                            <img class="calibration-map-image" src="assets/map_calibration.png" />
                        </div>
                    </div>
                </section>
            </main>

            <footer class="dev-footer">
                <div class="dev-footer-hints">
                    <span>USE COMMANDS WITH CARE</span>
                    <span class="dev-hint-divider"></span>
                    <span>CAN BREAK YOUR SAVE</span>
                </div>
            </footer>
        </div>
        <button id="dev-calibration-surface" class="calibration-surface">
            <span>CAPTURE CURRENT SPAWN</span>
        </button>
        <div id="vr-cursor"></div>
    </div>
</body>
</rml>
