* {
    box-sizing: border-box;
}

body {
    width: 1920px;
    height: 1080px;
    display: block;
    overflow: hidden;
    margin: 0;
    color: #d8d8d8;
    font-family: DragonBoard;
    background-color: transparent;
}

.inventory-app {
    position: relative;
    left: 0;
    top: 0;
    width: 1920px;
    height: 1080px;
    overflow: hidden;
    color: #d8d8d8;
    background-color: #070808;
    decorator: image("assets/Background/Inventory.png" fill);
}

.category-strip {
    position: absolute;
    left: 67px;
    top: 92px;
    width: 873px;
    height: 96px;
    display: flex;
    align-items: center;
}

.inventory-filter {
    width: 96px;
    height: 96px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 15px;
    padding: 8px;
    color: #b5b5b5;
    background-color: rgba(2, 3, 3, 126);
    border: 2px rgba(192, 192, 192, 142);
    tab-index: auto;
}

.inventory-filter:hover {
    color: #ffffff;
    background-color: rgba(32, 33, 33, 190);
    border-color: rgba(236, 236, 236, 220);
}

.inventory-filter.active {
    color: #ffffff;
    background-color: rgba(72, 66, 53, 188);
    border-color: #c7b27a;
}

.inventory-filter img {
    width: 72px;
    height: 72px;
    display: block;
    pointer-events: none;
}

#inventory-filter-misc {
    margin-right: 0;
}

.mod-title-banner {
    position: absolute;
    left: 980px;
    top: 92px;
    width: 876px;
    height: 96px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    color: #d6d6d6;
    text-align: center;
    background-color: rgba(0, 0, 0, 138);
    border: 2px rgba(142, 146, 149, 154);
}

.mod-title-banner .selected-name {
    width: 842px;
    height: 58px;
    max-height: 58px;
    margin-left: 0;
    overflow: hidden;
    font-size: 42px;
    line-height: 1.0;
    white-space: nowrap;
    text-overflow: ellipsis;
    text-align: center;
}

.inventory-list-panel {
    position: absolute;
    left: 28px;
    top: 222px;
    width: 730px;
    height: 670px;
}

.list-heading {
    width: 650px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 18px;
    color: #a7a7a7;
    font-size: 42px;
    letter-spacing: 4px;
    margin-left: 40px;
}

.list-heading-label {
    display: block;
}

.item-count {
    display: block;
    width: 90px;
    color: #d5d5d5;
    font-size: 46px;
    letter-spacing: 0;
    text-align: right;
}

.inventory-list-shell {
    position: relative;
    width: 730px;
    height: 600px;
    display: block;
}

.inventory-scroll-proxy {
    position: absolute;
    left: 0;
    top: 0;
    width: 42px;
    height: 600px;
    display: block;
    flex-shrink: 0;
    overflow: hidden;
}

.inventory-scroll-track {
    position: absolute;
    left: 8px;
    top: 0;
    width: 26px;
    height: 600px;
    background-color: rgba(50, 54, 58, 82);
    border: 1px rgba(106, 112, 118, 72);
    border-radius: 6px;
}

.inventory-scroll-thumb {
    position: absolute;
    left: 2px;
    top: 0;
    width: 22px;
    height: 104px;
    background-color: rgba(128, 142, 151, 138);
    border: 1px rgba(166, 178, 185, 118);
    border-radius: 5px;
}

.inventory-item-list {
    position: absolute;
    left: 40px;
    top: 0;
    width: 690px;
    height: 600px;
    display: block;
    overflow-x: hidden;
    overflow-y: hidden;
    margin-left: 0;
}

.inventory-item-list scrollbarvertical {
    width: 24px;
    opacity: 0;
    border: 0px transparent;
    background-color: transparent;
}

.inventory-item-list scrollbarvertical slidertrack,
.inventory-item-list scrollbarvertical sliderbar {
    width: 12px;
    margin-left: 5px;
    opacity: 0;
    border: 0px transparent;
    background-color: transparent;
}

.inventory-item-list scrollbarvertical sliderarrowdec,
.inventory-item-list scrollbarvertical sliderarrowinc {
    width: 0px;
    height: 0px;
}

.inventory-virtual-content {
    position: relative;
    width: 650px;
    flex-shrink: 0;
}

.inventory-list-item {
    position: absolute;
    left: 0;
    width: 650px;
    min-height: 112px;
    display: flex;
    align-items: center;
    margin: 0;
    padding: 8px 16px 8px 18px;
    overflow: hidden;
    color: #d0d0d0;
    font-family: DragonBoard;
    font-size: 48px;
    line-height: 1.0;
    text-align: left;
    background-color: transparent;
    border: 1px transparent;
    border-left: 2px transparent;
    tab-index: auto;
}

.inventory-list-item:nth-child(1) {
    width: 646px;
}

.inventory-list-item:nth-child(2) {
    width: 602px;
}

.inventory-list-item:nth-child(3) {
    width: 568px;
}

.inventory-list-item:nth-child(4) {
    width: 592px;
}

.inventory-list-item:nth-child(5) {
    width: 646px;
}

.inventory-list-item:nth-child(6),
.inventory-list-item:nth-child(9) {
    width: 646px;
}

.inventory-list-item:nth-child(7),
.inventory-list-item:nth-child(8) {
    width: 592px;
}

.row-fade {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 112px;
    display: block;
    pointer-events: none;
    decorator: horizontal-gradient(rgba(0, 0, 0, 112) rgba(0, 0, 0, 16));
}

.inventory-list-item:hover .row-fade,
.inventory-list-item.grip-scroll-locked .row-fade {
    decorator: horizontal-gradient(rgba(39, 39, 39, 174) rgba(39, 39, 39, 32));
}

.inventory-list-item.active {
    color: #ffffff;
    border-left-color: #c9b77e;
}

.inventory-list-item.active .row-fade {
    decorator: horizontal-gradient(rgba(54, 50, 42, 188) rgba(54, 50, 42, 34));
}

.inventory-list-item.equipped {
    border-left-color: #4e9d63;
}

.inventory-list-item.favorited {
    border-left-color: #d6b85d;
}

.inventory-list-item.equipped.favorited {
    border-left-color: #4e9d63;
}

.item-state-mark {
    position: relative;
    display: block;
    width: 58px;
    color: #a0a0a0;
    font-size: 28px;
    text-align: center;
    pointer-events: none;
}

.inventory-list-item.equipped .item-state-mark {
    color: #d9d9d9;
}

.item-name {
    position: relative;
    display: block;
    width: 410px;
    min-width: 410px;
    max-width: 410px;
    height: 64px;
    max-height: 64px;
    overflow: hidden;
    color: #d0d0d0;
    white-space: nowrap;
    line-height: 1.18;
    pointer-events: none;
}

.item-name-track {
    position: relative;
    left: 0;
    top: 0;
    display: block;
    width: 410px;
    max-width: 410px;
    height: 64px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    pointer-events: none;
}

.item-stack {
    position: relative;
    display: block;
    width: 64px;
    color: #b6b6b6;
    font-size: 38px;
    text-align: right;
    pointer-events: none;
}

.inventory-empty {
    width: 620px;
    padding: 200px 20px;
    color: #777777;
    font-size: 50px;
    text-align: center;
}

.inventory-preview-panel {
    position: absolute;
    left: 632px;
    top: 208px;
    width: 656px;
    height: 660px;
}

.preview-reticle {
    position: absolute;
    left: 325px;
    top: 327px;
    width: 6px;
    height: 6px;
    background-color: rgba(155, 155, 155, 86);
    border-radius: 3px;
}

.preview-interaction-zone {
    position: absolute;
    left: 178px;
    top: 180px;
    width: 300px;
    height: 300px;
    background-color: rgba(0, 0, 0, 0);
}

.hand-state {
    position: absolute;
    width: 82px;
    height: 82px;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
}

.hand-state.active {
    opacity: 1;
}

.equipped-hand-icon {
    display: block;
    width: 82px;
    height: 82px;
    pointer-events: none;
}

.left-hand-state {
    left: 52px;
    top: 288px;
}

.right-hand-state {
    right: 52px;
    top: 288px;
}

.inventory-details-panel {
    position: absolute;
    left: 1320px;
    top: 222px;
    width: 530px;
    height: 620px;
}

.selected-category {
    display: block;
    height: 30px;
    color: #858585;
    font-size: 28px;
    letter-spacing: 4px;
}

.detail-selected-category {
    width: 530px;
    height: 30px;
    display: block;
    padding-right: 18px;
    text-align: right;
}

.selected-name {
    display: block;
    width: 530px;
    max-height: 96px;
    overflow: hidden;
    color: #eeeeee;
    font-size: 50px;
    line-height: 0.96;
    text-align: center;
}

.detail-card {
    position: relative;
    width: 530px;
    overflow: hidden;
}

.detail-fade {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
    decorator: horizontal-gradient(rgba(0, 0, 0, 16) rgba(0, 0, 0, 112));
}

.description-card {
    height: 146px;
    margin-top: 6px;
}

.description-content {
    position: relative;
    width: 490px;
    height: 134px;
    margin-left: 40px;
    padding: 10px 18px 8px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    text-align: right;
}

.description-text {
    display: block;
    width: 454px;
    max-height: 124px;
    margin-top: 0;
    overflow: hidden;
    color: #d3d3d3;
    font-size: 34px;
    line-height: 1.05;
    text-align: right;
}

.attribute-grid {
    width: 530px;
    height: 360px;
    margin-top: 8px;
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    justify-content: space-between;
}

.attribute-card {
    width: 530px;
    height: 112px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
    padding: 0 46px 0 90px;
    background-color: rgba(0, 0, 0, 154);
    border-left: 1px rgba(124, 124, 124, 50);
}

.attribute-card.compact-card {
    width: 255px;
    height: 112px;
    flex-direction: column;
    justify-content: center;
    padding: 4px 20px;
}

.attribute-label {
    display: block;
    overflow: hidden;
    color: #d0d0d0;
    font-size: 48px;
    letter-spacing: 2px;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.attribute-value {
    display: block;
    overflow: hidden;
    color: #eeeeee;
    font-size: 48px;
    white-space: nowrap;
    text-align: right;
    text-overflow: ellipsis;
}

.compact-card .attribute-label {
    width: 215px;
    height: 50px;
    font-size: 48px;
    line-height: 1;
    text-align: center;
}

.compact-value {
    width: 215px;
    height: 50px;
    font-size: 48px;
    line-height: 1;
    text-align: center;
}

.quantity-row {
    width: 530px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding-right: 24px;
    color: #8f8f8f;
    font-size: 26px;
    letter-spacing: 2px;
}

.quantity-row span {
    display: block;
}

.quantity-row span:last-child {
    width: 82px;
    margin-left: 20px;
    color: #d2d2d2;
    font-size: 34px;
    letter-spacing: 0;
    text-align: right;
}

.inventory-search-shell {
    position: absolute;
    left: 104px;
    top: 908px;
    width: 492px;
    height: 62px;
}

.inventory-search {
    position: absolute;
    left: 0;
    top: 0;
    width: 486px;
    height: 62px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 18px;
    overflow: hidden;
    color: #666666;
    font-family: DragonBoard;
    font-size: 42px;
    letter-spacing: 3px;
    background-color: rgba(0, 0, 0, 150);
    border: 2px rgba(142, 146, 149, 158);
    tab-index: auto;
}

.inventory-search:hover,
.inventory-search.active {
    color: #bdbdbd;
    background-color: rgba(28, 28, 28, 204);
    border-color: rgba(190, 194, 197, 205);
}

.inventory-search.active {
    padding-right: 62px;
}

.inventory-search span {
    display: block;
    width: 100%;
    overflow: hidden;
    text-align: center;
    text-overflow: ellipsis;
    pointer-events: none;
}

.inventory-search-clear {
    position: absolute;
    right: 0;
    top: 0;
    width: 62px;
    height: 62px;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 0;
    color: #949494;
    font-family: DragonBoard;
    font-size: 30px;
    background-color: rgba(12, 12, 12, 196);
    border: 0px transparent;
    border-left: 1px rgba(100, 100, 100, 130);
    tab-index: auto;
}

.inventory-search-clear:hover {
    color: #ffffff;
    background-color: rgba(46, 46, 46, 220);
}

.inventory-search-clear span {
    pointer-events: none;
}

.inventory-actions {
    position: absolute;
    left: 635px;
    top: 932px;
    width: 650px;
    height: 70px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.inventory-action {
    width: 184px;
    height: 70px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 0;
    color: #dedede;
    font-family: DragonBoard;
    font-size: 46px;
    letter-spacing: 2px;
    background-color: rgba(8, 8, 8, 170);
    border: 2px rgba(175, 181, 184, 190);
    tab-index: auto;
}

.inventory-action:hover {
    color: #ffffff;
    background-color: rgba(48, 48, 48, 220);
    border-color: #e0e0e0;
}

.inventory-app.lang-ru .inventory-list-shell {
    height: 600px;
    max-height: 600px;
    overflow: hidden;
}

.inventory-app.lang-ru .inventory-list-item {
    height: 112px;
    max-height: 112px;
}

.inventory-app.lang-ru .description-text {
    overflow: hidden;
    font-size: 30px;
    line-height: 1.0;
}

.inventory-app.lang-ru .inventory-action {
    font-size: 30px;
    letter-spacing: 1px;
}

.inventory-app.lang-ru #inventory-equip {
    font-size: 25px;
    letter-spacing: 0;
}

.inventory-action.primary-action {
    background-color: rgba(56, 56, 56, 184);
    border-color: rgba(210, 215, 217, 218);
}

.inventory-action.pin-action {
    color: #fff0f0;
    background-color: #2c0d12;
    border-color: #452027;
}

.inventory-action.pin-action:hover {
    background-color: #3b1218;
    border-color: #5d343c;
}

.inventory-action.disabled {
    color: #5e5e5e;
    background-color: rgba(8, 8, 8, 105);
    border-color: rgba(68, 68, 68, 90);
}

.inventory-action span {
    display: block;
    width: 100%;
    text-align: center;
    pointer-events: none;
}

.player-currency {
    position: absolute;
    left: 76px;
    top: 988px;
    width: 650px;
    height: 54px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
}

.currency-inline {
    width: 240px;
    height: 54px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
}

.currency-inline.weight-inline {
    width: 390px;
    margin-left: 18px;
}

.summary-label {
    display: block;
    color: #929292;
    font-size: 34px;
    letter-spacing: 1px;
}

.summary-value {
    display: block;
    margin-left: 10px;
    color: #c8c8c8;
    font-size: 42px;
}

.player-vitals {
    position: absolute;
    left: 1320px;
    top: 864px;
    width: 530px;
    height: 226px;
}

.player-identity {
    width: 530px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: #e0e0e0;
}

.player-name {
    display: block;
    width: 400px;
    height: 50px;
    overflow: hidden;
    font-size: 46px;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.player-level {
    width: 122px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
}

.player-level-label {
    display: block;
    margin-right: 8px;
    color: #8d8d8d;
    font-size: 28px;
    letter-spacing: 1px;
}

.player-level-value {
    display: block;
    color: #e0e0e0;
    font-size: 42px;
}

.vital-row {
    width: 530px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
}

.vital-track {
    position: relative;
    width: 530px;
    height: 28px;
    display: block;
    overflow: hidden;
    background-color: rgba(3, 3, 3, 230);
    border: 1px rgba(112, 112, 112, 145);
}

.vital-fill {
    position: absolute;
    left: 0;
    top: 0;
    width: 0px;
    height: 26px;
    display: block;
}

.vital-value {
    position: absolute;
    left: 0;
    top: 1px;
    width: 528px;
    height: 26px;
    display: block;
    color: #d2d2d2;
    font-size: 23px;
    line-height: 1.05;
    text-align: center;
    pointer-events: none;
}

.health-fill {
    background-color: #3f2029;
}

.stamina-fill {
    background-color: #203a33;
}

.magicka-fill {
    background-color: #223348;
}

#vr-cursor {
    position: absolute;
    left: 960px;
    top: 540px;
    width: 24px;
    height: 24px;
    margin-left: -12px;
    margin-top: -12px;
    pointer-events: none;
    background-color: #d8d8d8;
    border: 4px #747676;
    border-radius: 13px;
}
