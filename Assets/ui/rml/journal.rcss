/* Quest category filters. */
.journal-quest-filters {
    position: absolute;
    z-index: 3;
    left: 44px;
    top: 155px;
    width: 400px;
    height: 62px;
    display: flex;
    flex-direction: row;
    padding: 0;
}

.journal-filter-button {
    width: 92px;
    min-width: 92px;
    height: 56px;
    margin-right: 8px;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #96999a;
    font-size: 28px;
    text-align: center;
    background-color: rgba(12, 13, 13, 185);
    border: 1px rgba(74, 77, 78, 105);
}

.journal-filter-button span {
    width: 92px;
    display: block;
    text-align: center;
}

.journal-filter-button:hover {
    color: #e0e2e2;
    background-color: rgba(31, 19, 21, 210);
    border-color: rgba(90, 55, 61, 145);
}

#journal-filter-main:hover {
    color: #f0e7e8;
    background-color: rgba(49, 13, 19, 220);
    border-color: rgba(101, 48, 58, 185);
}

#journal-filter-side:hover {
    color: #d9e2eb;
    background-color: rgba(12, 24, 41, 220);
    border-color: rgba(42, 65, 89, 185);
}

#journal-filter-misc:hover {
    color: #e7dfbe;
    background-color: rgba(51, 42, 11, 220);
    border-color: rgba(101, 84, 30, 185);
}

.journal-filter-button.active {
    color: #f0e7e8;
    background-color: rgba(44, 13, 18, 220);
    border-color: rgba(87, 48, 57, 185);
}

#journal-filter-main.active {
    color: #f0e7e8;
    background-color: rgba(49, 13, 19, 228);
    border-color: rgba(101, 48, 58, 195);
}

#journal-filter-side.active {
    color: #d9e2eb;
    background-color: rgba(10, 22, 38, 228);
    border-color: rgba(42, 65, 89, 195);
}

#journal-filter-misc.active {
    color: #e7dfbe;
    background-color: rgba(48, 40, 10, 228);
    border-color: rgba(101, 84, 30, 195);
}

/* Match each sidebar quest's hover/selected fade to its quest category. */
.journal-quest-button.quest-category-main:hover .fade-1,
.journal-quest-button.quest-category-main.active .fade-1 { background-color: rgba(49, 13, 19, 210); }
.journal-quest-button.quest-category-main:hover .fade-2,
.journal-quest-button.quest-category-main.active .fade-2 { background-color: rgba(49, 13, 19, 155); }
.journal-quest-button.quest-category-main:hover .fade-3,
.journal-quest-button.quest-category-main.active .fade-3 { background-color: rgba(49, 13, 19, 100); }
.journal-quest-button.quest-category-main:hover .fade-4,
.journal-quest-button.quest-category-main.active .fade-4 { background-color: rgba(49, 13, 19, 58); }
.journal-quest-button.quest-category-main:hover .fade-5,
.journal-quest-button.quest-category-main.active .fade-5 { background-color: rgba(49, 13, 19, 25); }

.journal-quest-button.quest-category-side:hover .fade-1,
.journal-quest-button.quest-category-side.active .fade-1 { background-color: rgba(10, 22, 38, 210); }
.journal-quest-button.quest-category-side:hover .fade-2,
.journal-quest-button.quest-category-side.active .fade-2 { background-color: rgba(10, 22, 38, 155); }
.journal-quest-button.quest-category-side:hover .fade-3,
.journal-quest-button.quest-category-side.active .fade-3 { background-color: rgba(10, 22, 38, 100); }
.journal-quest-button.quest-category-side:hover .fade-4,
.journal-quest-button.quest-category-side.active .fade-4 { background-color: rgba(10, 22, 38, 58); }
.journal-quest-button.quest-category-side:hover .fade-5,
.journal-quest-button.quest-category-side.active .fade-5 { background-color: rgba(10, 22, 38, 25); }

.journal-quest-button.quest-category-misc:hover .fade-1,
.journal-quest-button.quest-category-misc.active .fade-1 { background-color: rgba(48, 40, 10, 210); }
.journal-quest-button.quest-category-misc:hover .fade-2,
.journal-quest-button.quest-category-misc.active .fade-2 { background-color: rgba(48, 40, 10, 155); }
.journal-quest-button.quest-category-misc:hover .fade-3,
.journal-quest-button.quest-category-misc.active .fade-3 { background-color: rgba(48, 40, 10, 100); }
.journal-quest-button.quest-category-misc:hover .fade-4,
.journal-quest-button.quest-category-misc.active .fade-4 { background-color: rgba(48, 40, 10, 58); }
.journal-quest-button.quest-category-misc:hover .fade-5,
.journal-quest-button.quest-category-misc.active .fade-5 { background-color: rgba(48, 40, 10, 25); }

.journal-quest-list {
    top: 229px;
    height: 770px;
}

/* Journal.jpg composition: 29.4% sidebar and reduced main workspace. */
.journal-sidebar {
    width: 566px;
}

.journal-shell,
