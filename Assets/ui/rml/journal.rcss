}

.journal-main {
    padding-left: 25px;
}

.journal-page,
.journal-workspace,
.journal-details-card {
    width: 1381px;
}

.journal-details-card {
    border: 1px rgba(100, 102, 102, 120);
}

.journal-summary-row,
.journal-objectives-heading,
.journal-objective-list {
