* {
    box-sizing: border-box;
}

body {
    width: 1920px;
    height: 1080px;
    display: block;
    overflow: hidden;
    margin: 0;
    color: #d8d8d8;
    font-family: DragonBoard;
    background-color: transparent;
}

.magic-app {
    position: relative;
    left: 0;
    top: 0;
    width: 1920px;
    height: 1080px;
    overflow: hidden;
    color: #d8d8d8;
    background-color: #070808;
    decorator: image("assets/Magic.png" fill);
}

.magic-filter-strip {
    position: absolute;
    left: 76px;
    top: 92px;
    width: 792px;
    height: 116px;
    display: flex;
    align-items: center;
}

.magic-filter {
    width: 100px;
    height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 12px;
    padding: 7px;
    color: #b5b5b5;
    background-color: rgba(2, 3, 3, 126);
    border: 2px rgba(192, 192, 192, 142);
    tab-index: auto;
}

.magic-filter:hover {
    color: #ffffff;
    background-color: rgba(32, 33, 33, 190);
    border-color: rgba(236, 236, 236, 220);
}

.magic-filter.active {
    color: #ffffff;
    background-color: rgba(72, 66, 53, 188);
    border-color: #c7b27a;
}

.magic-filter img {
    width: 82px;
    height: 82px;
    display: block;
    pointer-events: none;
}

#magic-filter-passive {
    margin-right: 0;
}

.spell-title-banner {
    position: absolute;
    left: 1050px;
    top: 100px;
    width: 800px;
    height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    color: #d6d6d6;
    text-align: center;
    background-color: rgba(0, 0, 0, 138);
    border: 2px rgba(142, 146, 149, 154);
}

.spell-title {
    display: block;
    width: 760px;
    height: 58px;
    overflow: hidden;
    color: #eeeeee;
    font-size: 42px;
    line-height: 1;
    white-space: nowrap;
    text-overflow: ellipsis;
    text-align: center;
}

.magic-list-panel {
    position: absolute;
    left: 28px;
    top: 222px;
    width: 730px;
    height: 670px;
}

.list-heading {
    width: 650px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 18px;
    margin-left: 40px;
    color: #a7a7a7;
    font-size: 42px;
    letter-spacing: 4px;
}

.list-heading-label {
    display: block;
}

.spell-count {
    display: block;
    width: 90px;
    color: #d5d5d5;
    font-size: 46px;
    letter-spacing: 0;
    text-align: right;
}

.magic-list-shell {
    position: relative;
    width: 730px;
    height: 600px;
    display: block;
}

.magic-scroll-proxy {
    position: absolute;
    left: 0;
    top: 0;
    width: 30px;
    height: 600px;
    display: block;
    overflow: hidden;
}

.magic-scroll-track {
    position: absolute;
    left: 7px;
    top: 0;
    width: 14px;
    height: 600px;
    background-color: rgba(50, 54, 58, 82);
    border: 1px rgba(106, 112, 118, 72);
    border-radius: 4px;
}

.magic-scroll-thumb {
    position: absolute;
    left: 1px;
    top: 0;
    width: 12px;
    height: 104px;
    background-color: rgba(128, 142, 151, 138);
    border: 1px rgba(166, 178, 185, 118);
    border-radius: 4px;
}

.magic-spell-list {
    position: absolute;
    left: 40px;
    top: 0;
    width: 690px;
    height: 600px;
    display: block;
    overflow: hidden;
}

.magic-virtual-content {
    position: relative;
    width: 650px;
    height: 600px;
}

.magic-list-item {
    position: absolute;
    left: 0;
    width: 650px;
    min-height: 112px;
    display: flex;
    align-items: center;
    margin: 0;
    padding: 8px 16px 8px 18px;
    overflow: hidden;
    color: #d0d0d0;
    font-family: DragonBoard;
    font-size: 48px;
    line-height: 1;
    text-align: left;
    background-color: transparent;
    border: 1px transparent;
    border-left: 2px transparent;
    tab-index: auto;
}

.magic-list-item:nth-child(1) {
    width: 646px;
}

.magic-list-item:nth-child(2) {
    width: 602px;
}

.magic-list-item:nth-child(3) {
    width: 568px;
}

.magic-list-item:nth-child(4) {
    width: 592px;
}

.magic-list-item:nth-child(5) {
    width: 646px;
}

.row-fade {
    position: absolute;
    top: 0;
    height: 112px;
    display: block;
    pointer-events: none;
}

.row-fade-solid {
    left: 0;
    width: 36%;
    background-color: rgba(0, 0, 0, 112);
}

.row-fade-strong {
    left: 36%;
    width: 18%;
    background-color: rgba(0, 0, 0, 82);
}

.row-fade-mid {
    left: 54%;
    width: 16%;
    background-color: rgba(0, 0, 0, 56);
}

.row-fade-soft {
    left: 70%;
    width: 15%;
    background-color: rgba(0, 0, 0, 34);
}

.row-fade-whisper {
    left: 85%;
    width: 15%;
    background-color: rgba(0, 0, 0, 16);
}

.magic-list-item:hover .row-fade-solid,
.magic-list-item.grip-scroll-locked .row-fade-solid {
    background-color: rgba(39, 39, 39, 174);
}

.magic-list-item:hover .row-fade-strong,
.magic-list-item.grip-scroll-locked .row-fade-strong {
    background-color: rgba(39, 39, 39, 142);
}

.magic-list-item:hover .row-fade-mid,
.magic-list-item.grip-scroll-locked .row-fade-mid {
    background-color: rgba(39, 39, 39, 106);
}

.magic-list-item:hover .row-fade-soft,
.magic-list-item.grip-scroll-locked .row-fade-soft {
    background-color: rgba(39, 39, 39, 68);
}

.magic-list-item:hover .row-fade-whisper,
.magic-list-item.grip-scroll-locked .row-fade-whisper {
    background-color: rgba(39, 39, 39, 32);
}

.magic-list-item.active {
    color: #ffffff;
    border-left-color: #c9b77e;
}

.magic-list-item.active .row-fade-solid {
    background-color: rgba(54, 50, 42, 188);
}

.magic-list-item.active .row-fade-strong {
    background-color: rgba(54, 50, 42, 150);
}

.magic-list-item.active .row-fade-mid {
    background-color: rgba(54, 50, 42, 112);
}

.magic-list-item.active .row-fade-soft {
    background-color: rgba(54, 50, 42, 72);
}

.magic-list-item.active .row-fade-whisper {
    background-color: rgba(54, 50, 42, 34);
}

.magic-list-item.equipped {
    border-left-color: #4e9d63;
}

.magic-list-item.favorited {
    border-left-color: #d6b85d;
}

.spell-state-mark {
    position: relative;
    display: block;
    width: 58px;
    min-width: 58px;
    max-width: 58px;
    color: #a0a0a0;
    font-size: 28px;
    text-align: center;
    pointer-events: none;
}

.spell-name {
    position: relative;
    display: block;
    width: 468px;
    min-width: 468px;
    max-width: 468px;
    height: 64px;
    overflow: hidden;
    color: #d0d0d0;
    white-space: nowrap;
    line-height: 1.18;
    pointer-events: none;
}

.spell-name-track {
    position: relative;
    left: 0;
    top: 0;
    display: block;
    width: 468px;
    max-width: 468px;
    height: 64px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    pointer-events: none;
}

.magic-empty {
    width: 620px;
    padding: 200px 20px;
    color: #777777;
    font-size: 50px;
    text-align: center;
}

.magic-preview-panel {
    position: absolute;
    left: 632px;
    top: 208px;
    width: 656px;
    height: 660px;
}

.preview-icon {
    position: absolute;
    left: 178px;
    top: 180px;
    width: 300px;
    height: 300px;
    display: none;
    opacity: 0.58;
    pointer-events: none;
}

.preview-reticle {
    position: absolute;
    left: 325px;
    top: 327px;
    width: 6px;
    height: 6px;
    background-color: rgba(155, 155, 155, 86);
    border-radius: 3px;
}

.preview-interaction-zone {
    position: absolute;
    left: 178px;
    top: 180px;
    width: 300px;
    height: 300px;
    background-color: rgba(0, 0, 0, 0);
}

.hand-state {
    position: absolute;
    width: 82px;
    height: 82px;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
}

.hand-state.active {
    opacity: 1;
}

.equipped-hand-icon {
    display: block;
    width: 82px;
    height: 82px;
    pointer-events: none;
}

.left-hand-state {
    left: 52px;
    top: 288px;
}

.right-hand-state {
    right: 52px;
    top: 288px;
}

.magic-details-panel {
    position: absolute;
    left: 1320px;
    top: 222px;
    width: 530px;
    height: 610px;
}

.spell-category {
    width: 530px;
    height: 30px;
    display: block;
    padding-right: 18px;
    color: #858585;
    font-size: 28px;
    letter-spacing: 4px;
    text-align: right;
}

.detail-card {
    position: relative;
    width: 530px;
    overflow: hidden;
}

.detail-fade {
    position: absolute;
    top: 0;
    height: 100%;
    display: block;
    pointer-events: none;
}

.detail-fade.fade-soft {
    left: 15%;
    width: 15%;
    background-color: rgba(0, 0, 0, 34);
}

.detail-fade.fade-mid {
    left: 30%;
    width: 16%;
    background-color: rgba(0, 0, 0, 56);
}

.detail-fade.fade-strong {
    left: 46%;
    width: 18%;
    background-color: rgba(0, 0, 0, 82);
}

.detail-fade.fade-solid {
    left: 64%;
    width: 36%;
    background-color: rgba(0, 0, 0, 112);
}

.detail-fade.fade-whisper {
    left: 0;
    width: 15%;
    background-color: rgba(0, 0, 0, 16);
}

.spell-description {
    height: 146px;
    margin-top: 6px;
}

.description-content {
    position: relative;
    width: 490px;
    height: 134px;
    margin-left: 40px;
    padding: 10px 18px 8px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    text-align: right;
}

.description-text {
    display: block;
    width: 454px;
    max-height: 126px;
    overflow: hidden;
    color: #d3d3d3;
    font-size: 40px;
    line-height: 1.05;
    text-align: right;
}

.attribute-list {
    width: 530px;
    height: 416px;
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    justify-content: space-between;
    margin-top: 8px;
}

.attribute-row {
    width: 530px;
    height: 96px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
    padding: 0 46px 0 72px;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 154);
    border-left: 1px rgba(124, 124, 124, 50);
}

.cost-row {
    height: 96px;
}

.cost-row .attribute-value {
    width: 110px;
}

.half-row {
    width: 255px;
    height: 96px;
    flex-direction: column;
    justify-content: center;
    padding: 4px 14px;
}

.attribute-label {
    display: block;
    overflow: hidden;
    color: #858b8e;
    font-size: 32px;
    letter-spacing: 1px;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.attribute-value {
    display: block;
    width: 170px;
    overflow: hidden;
    color: #eeeeee;
    font-size: 44px;
    white-space: nowrap;
    text-align: right;
    text-overflow: ellipsis;
}

.attribute-value.text-value {
    width: 290px;
    font-size: 44px;
    text-overflow: ellipsis;
}

.half-row .attribute-label {
    width: 227px;
    height: 38px;
    font-size: 30px;
    line-height: 1;
    text-align: center;
}

.half-row .attribute-value.text-value {
    width: 227px;
    height: 44px;
    font-size: 40px;
    line-height: 1;
    text-align: center;
}

.magic-search-shell {
    position: absolute;
    left: 104px;
    top: 908px;
    width: 492px;
    height: 62px;
}

.magic-search {
    position: absolute;
    left: 0;
    top: 0;
    width: 486px;
    height: 62px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 18px;
    overflow: hidden;
    color: #666666;
    font-family: DragonBoard;
    font-size: 42px;
    letter-spacing: 3px;
    background-color: rgba(0, 0, 0, 150);
    border: 2px rgba(142, 146, 149, 158);
    tab-index: auto;
}

.magic-search:hover,
.magic-search.active {
    color: #bdbdbd;
    background-color: rgba(28, 28, 28, 204);
    border-color: rgba(190, 194, 197, 205);
}

.magic-search.active {
    padding-right: 62px;
}

.magic-search span {
    display: block;
    width: 100%;
    overflow: hidden;
    text-align: center;
    text-overflow: ellipsis;
    pointer-events: none;
}

.magic-search-clear {
    position: absolute;
    right: 0;
    top: 0;
    width: 62px;
    height: 62px;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 0;
    color: #949494;
    font-family: DragonBoard;
    font-size: 30px;
    background-color: rgba(12, 12, 12, 196);
    border: 0px transparent;
    border-left: 1px rgba(100, 100, 100, 130);
    tab-index: auto;
}

.magic-search-clear:hover {
    color: #ffffff;
    background-color: rgba(46, 46, 46, 220);
}

.magic-search-clear span {
    pointer-events: none;
}

.magic-actions {
    position: absolute;
    left: 745px;
    top: 932px;
    width: 430px;
    height: 70px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.magic-action {
    width: 184px;
    height: 70px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 0;
    color: #dedede;
    font-family: DragonBoard;
    font-size: 46px;
    letter-spacing: 2px;
    background-color: rgba(8, 8, 8, 170);
    border: 2px rgba(175, 181, 184, 190);
    tab-index: auto;
}

.magic-action:hover {
    color: #ffffff;
    background-color: rgba(48, 48, 48, 220);
    border-color: #e0e0e0;
}

.magic-action.primary-action {
    background-color: rgba(56, 56, 56, 184);
    border-color: rgba(210, 215, 217, 218);
}

.magic-action.pin-action {
    color: #fff0f0;
    background-color: #2c0d12;
    border-color: #452027;
}

.magic-action.pin-action:hover,
.magic-action.pin-action.active {
    background-color: #3b1218;
    border-color: #5d343c;
}

.magic-action.disabled {
    color: #5e5e5e;
    background-color: rgba(8, 8, 8, 105);
    border-color: rgba(68, 68, 68, 90);
}

.magic-action span {
    display: block;
    width: 100%;
    text-align: center;
    pointer-events: none;
}

.magic-pin-menu {
    position: absolute;
    left: 705px;
    top: 858px;
    width: 510px;
    height: 58px;
    display: none;
    align-items: center;
    justify-content: space-between;
}

.magic-pin-menu.active {
    display: flex;
}

.pin-option {
    width: 150px;
    height: 54px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 3px;
    color: #d8caca;
    font-family: DragonBoard;
    font-size: 27px;
    text-align: center;
    background-color: #281015;
    border: 2px #4b2229;
    tab-index: auto;
}

.pin-option:hover {
    color: #ffffff;
    background-color: #3b1218;
    border-color: #5d343c;
}

.pin-option span {
    pointer-events: none;
}

.magic-app.lang-ru .spell-title {
    font-size: 38px;
    line-height: 1.08;
}

.magic-app.lang-ru .list-heading {
    font-size: 36px;
    letter-spacing: 2px;
}

.magic-app.lang-ru .magic-list-item {
    font-size: 43px;
}

.magic-app.lang-ru .spell-name {
    line-height: 1.08;
}

.magic-app.lang-ru .magic-empty {
    font-size: 44px;
}

.magic-app.lang-ru .spell-category {
    font-size: 24px;
    letter-spacing: 2px;
}

.magic-app.lang-ru .description-text {
    font-size: 29px;
    line-height: 1.08;
}

.magic-app.lang-ru .attribute-label {
    font-size: 24px;
}

.magic-app.lang-ru .attribute-value.text-value {
    font-size: 38px;
}

.magic-app.lang-ru .half-row .attribute-label {
    font-size: 15px;
    line-height: 1.02;
    white-space: normal;
}

.magic-app.lang-ru .half-row .attribute-value.text-value {
    font-size: 17px;
    line-height: 1.05;
    white-space: normal;
}

.magic-app.lang-ru .magic-action {
    font-size: 26px;
    letter-spacing: 1px;
}

.magic-app.lang-ru .pin-option {
    font-size: 17px;
    line-height: 1.05;
}

.magic-app.lang-ru .pin-option span {
    display: block;
    width: 100%;
    text-align: center;
}

.magic-player-vitals {
    position: absolute;
    left: 1320px;
    top: 901px;
    width: 530px;
    height: 90px;
}

.player-identity {
    width: 530px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: #e0e0e0;
}

.player-name {
    display: block;
    width: 400px;
    height: 50px;
    overflow: hidden;
    font-size: 46px;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.player-level {
    width: 122px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
}

.player-level-label {
    display: block;
    margin-right: 8px;
    color: #8d8d8d;
    font-size: 28px;
    letter-spacing: 1px;
}

.player-level-value {
    display: block;
    color: #e0e0e0;
    font-size: 42px;
}

.magicka-track {
    position: relative;
    width: 530px;
    height: 28px;
    display: block;
    overflow: hidden;
    background-color: rgba(3, 3, 3, 230);
    border: 1px rgba(112, 112, 112, 145);
}

.magicka-fill {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 26px;
    display: block;
    background-color: #223348;
}

.magicka-value {
    position: absolute;
    left: 0;
    top: 1px;
    width: 528px;
    height: 26px;
    display: block;
    color: #d2d2d2;
    font-size: 23px;
    line-height: 1.05;
    text-align: center;
    pointer-events: none;
}

#vr-cursor {
    position: absolute;
    left: 960px;
    top: 540px;
    width: 24px;
    height: 24px;
    margin-left: -12px;
    margin-top: -12px;
    pointer-events: none;
    background-color: #d8d8d8;
    border: 4px #747676;
    border-radius: 13px;
}
