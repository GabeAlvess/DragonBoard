<rml>
<head>
    <title>DragonBoard Settings</title>
    <link type="text/rcss" href="settings.rcss" />
</head>
<body>
    <div id="app">
        <aside>
            <div class="brand">
                <div class="brand-copy">
                    <div class="brand-name">DragonBoard</div>
                </div>
            </div>

            <div class="section-label">SETTINGS</div>
            <button id="tab-general" class="nav-item"><span>General</span></button>
            <button id="tab-visuals" class="nav-item"><span>Visuals</span></button>
            <button id="tab-items" class="nav-item"><span>Item scale</span></button>
        </aside>

        <div class="content-shell">
            <header>
                <div class="breadcrumb"><span class="breadcrumb-muted">Configuration</span><span class="breadcrumb-slash">/</span><span>DragonBoard</span></div>
                <button id="close" class="close-button"><span>Close</span></button>
            </header>

            <main id="page-scroll">
                <section id="page-general" class="page">
                    <h1>General</h1>
                    <p class="lead">Adjust the overall size and spacing of your board.</p>
                    <div class="settings-card">
                        <div class="setting-row toggle-setting">
                            <div class="setting-copy"><span class="setting-label">Item edit mode</span><span class="setting-help">Allow secondary-button editing in inventory, magic and other containers</span></div>
                            <div class="toggle-space"></div>
                            <button id="toggle-edit-mode" class="toggle-button">
                                <span class="toggle-track"><span class="toggle-knob"></span></span>
                                <span id="toggle-edit-state" class="toggle-state">Enabled</span>
                            </button>
                        </div>
                        <div class="setting-row toggle-setting">
                            <div class="setting-copy"><span class="setting-label">Developer panel</span><span class="setting-help">Show the Dev button on DragonBoard</span></div>
                            <div class="toggle-space"></div>
                            <button id="toggle-dev-panel" class="toggle-button">
                                <span class="toggle-track"><span class="toggle-knob"></span></span>
                                <span id="toggle-dev-state" class="toggle-state">Disabled</span>
                            </button>
                        </div>
                        <div class="setting-row toggle-setting">
                            <div class="setting-copy"><span class="setting-label">Pin board to world</span><span class="setting-help">Keep the whole DragonBoard at its current world position</span></div>
                            <div class="toggle-space"></div>
                            <button id="toggle-world-pin" class="toggle-button">
                                <span class="toggle-track"><span class="toggle-knob"></span></span>
                                <span id="toggle-world-pin-state" class="toggle-state">Hand</span>
                            </button>
                        </div>
                        <div class="setting-row">
                            <div class="setting-copy"><span class="setting-label">Restart DragonBoard</span><span class="setting-help">Recreate all components after a player skeleton change</span></div>
                            <button id="restart-dragonboard" class="save-button restart-button"><span>Restart now</span></button>
                        </div>
                        <div class="setting-row featured">
                            <div class="setting-copy"><span class="setting-label">Menu scale</span><span class="setting-help">Overall board size in your field of view</span></div>
                            <input id="menuScale" type="range" class="range" min="0.25" max="3" step="0.01" value="1" />
                            <span id="value-menuScale" class="value">1.00</span>
                        </div>
                    </div>
                    <div class="hint"><span class="hint-icon">i</span><span>Changes are previewed instantly. Save when the board feels comfortable at arm's length.</span></div>
                </section>

                <section id="page-visuals" class="page">
                    <h1>Visuals</h1>
                    <p class="lead">Fine-tune the scale of the board's 3D elements.</p>
                    <div class="settings-card">
                        <div class="setting-row"><div class="setting-copy"><span class="setting-label">Reticle scale</span><span class="setting-help">Laser pointer impact marker</span></div><input id="reticleScale" type="range" class="range" min="0.1" max="10" step="0.05" value="2.5" /><span id="value-reticleScale" class="value">2.50</span></div>
                    </div>
                </section>

                <section id="page-items" class="page">
                    <h1>Item scale</h1>
                    <p class="lead">Set a comfortable display size for each item category.</p>
                    <div class="settings-card">
                        <div class="setting-row"><div class="setting-copy"><span class="setting-label">Weapons</span><span class="setting-help">Swords, bows and staves</span></div><input id="itemWeaponScale" type="range" class="range" min="0.1" max="5" step="0.01" value="1" /><span id="value-itemWeaponScale" class="value">1.00</span></div>
                        <div class="setting-row"><div class="setting-copy"><span class="setting-label">Armor</span><span class="setting-help">Apparel, shields and jewelry</span></div><input id="itemArmorScale" type="range" class="range" min="0.1" max="5" step="0.01" value="1" /><span id="value-itemArmorScale" class="value">1.00</span></div>
                        <div class="setting-row"><div class="setting-copy"><span class="setting-label">Potions</span><span class="setting-help">Potions and poisons</span></div><input id="itemPotionScale" type="range" class="range" min="0.1" max="5" step="0.01" value="1" /><span id="value-itemPotionScale" class="value">1.00</span></div>
                        <div class="setting-row"><div class="setting-copy"><span class="setting-label">Food</span><span class="setting-help">Food and ingredients</span></div><input id="itemFoodScale" type="range" class="range" min="0.1" max="5" step="0.01" value="1" /><span id="value-itemFoodScale" class="value">1.00</span></div>
                        <div class="setting-row"><div class="setting-copy"><span class="setting-label">Miscellaneous</span><span class="setting-help">Books, keys and other objects</span></div><input id="itemMiscScale" type="range" class="range" min="0.1" max="5" step="0.01" value="1" /><span id="value-itemMiscScale" class="value">1.00</span></div>
                    </div>
                </section>

            </main>

            <footer>
                <div class="footer-spacer"></div>
                <div class="save-status">Ready to save</div>
                <button id="save" class="save-button"><span>Save changes</span></button>
            </footer>
        </div>
        <div id="vr-cursor"></div>
    </div>
</body>
</rml>
