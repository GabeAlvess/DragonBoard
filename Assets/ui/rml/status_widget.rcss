* { box-sizing: border-box; }

body {
    width: 950px;
    height: 80px;
    margin: 0;
    color: #e8e3d6;
    font-family: DragonBoard;
    background-color: transparent;
}

.status-panel {
    width: 950px;
    height: 80px;
    padding: 0 30px;
    display: flex;
    align-items: center;
    background-color: #000000b3;
    border: 2.5px #7b725d99;
}

.separator {
    width: 2.5px;
    height: 40px;
    margin: 0 10px;
    background-color: #7b725d99;
}

.stat-block {
    height: 80px;
    display: flex;
    align-items: center;
    white-space: nowrap;
}

.name-block { width: 275px; }
.level-block { width: 137.5px; }
.gold-block { width: 175px; }
.weight-block { width: 230px; }

.label {
    color: #aaa28e;
    font-size: 31.5px;
    margin-right: 15px;
}

.value {
    color: #f2eee4;
    font-size: 42px;
}

.player-name {
    width: 260px;
    overflow: hidden;
    letter-spacing: 2.5px;
}

.gold { color: #d6bd70; }

#status-level {
    color: #70c878;
}

.weight-divider {
    margin: 0 5px;
}

.overloaded {
    color: #e05252;
}

#vr-cursor {
    position: absolute;
    display: none;
    left: 475px;
    top: 40px;
    width: 17.5px;
    height: 17.5px;
    margin-left: -7.5px;
    margin-top: -7.5px;
    pointer-events: none;
    background-color: #eeeeee;
    border: 2.5px #646666;
    border-radius: 10px;
}
