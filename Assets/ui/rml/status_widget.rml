<rml>
<head>
    <title>DragonBoard Status</title>
    <link type="text/rcss" href="status_widget.rcss" />
</head>
<body>
    <div class="status-panel">
        <div class="stat-block name-block">
            <span id="status-name" class="value player-name">DRAGONBORN</span>
        </div>
        <div class="separator"></div>
        <div class="stat-block level-block">
            <span class="label">LEVEL</span>
            <span id="status-level" class="value">1</span>
        </div>
        <div class="separator"></div>
        <div class="stat-block gold-block">
            <span class="label">GOLD</span>
            <span id="status-gold" class="value gold">0</span>
        </div>
        <div class="separator"></div>
        <div class="stat-block weight-block">
            <span class="label">WEIGHT</span>
            <span id="status-weight-current" class="value">0</span>
            <span class="value weight-divider"> / </span>
            <span id="status-weight-capacity" class="value">0</span>
        </div>
        <div id="vr-cursor"></div>
    </div>
</body>
</rml>
