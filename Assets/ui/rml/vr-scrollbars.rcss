/* Large native RmlUi scrollbars sized for VR controller rays. */
scrollbarvertical {
    width: 42px;
    background-color: transparent;
    border: 0px transparent;
    border-radius: 6px;
}

scrollbarvertical sliderarrowdec,
scrollbarvertical sliderarrowinc {
    width: 0;
    height: 0;
}

scrollbarvertical slidertrack {
    width: 26px;
    margin-left: 8px;
    background-color: rgba(50, 54, 58, 82);
    border: 1px rgba(106, 112, 118, 72);
    border-radius: 6px;
}

scrollbarvertical sliderbar {
    width: 22px;
    min-height: 116px;
    margin-left: 10px;
    background-color: rgba(128, 142, 151, 138);
    border: 1px rgba(166, 178, 185, 118);
    border-radius: 5px;
}

scrollbarhorizontal {
    height: 30px;
    background-color: rgba(26, 27, 27, 220);
    border: 2px #555757;
    border-radius: 5px;
}

scrollbarhorizontal sliderarrowdec,
scrollbarhorizontal sliderarrowinc {
    width: 0;
    height: 0;
}

scrollbarhorizontal slidertrack {
    height: 18px;
    margin-top: 4px;
    background-color: #303232;
    border: 1px #555757;
    border-radius: 5px;
}

scrollbarhorizontal sliderbar {
    min-width: 96px;
    height: 18px;
    margin-top: 4px;
    background-color: #b58a35;
    border: 2px #e0ba5b;
    border-radius: 5px;
}
